FROM node:22-alpine AS builder
WORKDIR /app
COPY ecs/package.json ecs/package-lock.json* ./ecs/
WORKDIR /app/ecs
RUN npm install --no-audit --no-fund --ignore-scripts && ln -s /app/ecs/node_modules /app/node_modules
COPY ecs/tsconfig.json ./
COPY ecs/src/ ./src/

COPY src/ /app/src/

RUN npx tsc

FROM node:22-alpine
WORKDIR /app/ecs
RUN apk add --no-cache tini
COPY --chown=node:node --from=builder /app/ecs/dist ./dist
COPY --chown=node:node --from=builder /app/ecs/node_modules ./node_modules
COPY --chown=node:node ecs/package.json ./package.json
ENV NODE_ENV=production
EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
USER node
CMD ["node", "dist/ecs/src/api/server.js"]
